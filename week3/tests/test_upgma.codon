from python import time
from .. code.phylo import upgma, Tree
from typing import List

def test_upgma() -> None:
    # D: List[List[float]] = [
    #     [0.0, 5.0, 9.0, 9.0, 8.0],
    #     [5.0, 0.0,10.0,10.0,9.0],
    #     [9.0,10.0, 0.0, 8.0,7.0],
    #     [9.0,10.0, 8.0, 0.0,3.0],
    #     [8.0, 9.0, 7.0, 3.0,0.0],
    # ]
    D = [[abs(i - j) * 1.1 for j in range(100)] for i in range(100)]

    tree: Tree = upgma(D)
    d02 = tree.get_distance(0,2)
    d34 = tree.get_distance(3,4)
    print(f"UPGMA: dist(0,2)={d02:.3f}, dist(3,4)={d34:.3f}")

def main():
    t0 = time.perf_counter()
    for _ in range(20):
        test_upgma()
    # test_upgma()
    print(f"Runtime: {int((time.perf_counter() - t0)*1000)}ms")

if __name__ == "__main__":
    main()

