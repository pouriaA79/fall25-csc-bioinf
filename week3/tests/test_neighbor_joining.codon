from python import time
from .. code.phylo import neighbor_joining
from python import numpy as pnp
import numpy.pybridge
def test_neighbor_joining() -> None:
    D = pnp.loadtxt("tests/distances.txt", dtype=pnp.int64)
    tree = neighbor_joining(D)
    print("NeighborJoining: dist(3,4) =", tree.get_distance(3,4))
    print("NeighborJoining: dist(0,1) =", tree.get_distance(0,1))

def main():
    t0 = time.perf_counter()
    for _ in range(1):
        test_neighbor_joining()
    print(f"Runtime: {int((time.perf_counter() - t0)*1000)}ms")

if __name__ == "__main__":
    main()
